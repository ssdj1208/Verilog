# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/u_bufg_clkdiv0]
set_property LOC BUFGCTRL_X0Y2 [get_cells demo_clk_ctrl/soc_clk_bufg]
set_property LOC BUFGCTRL_X0Y3 [get_cells clkgen/soc_clk_100_bufg]
set_property LOC BUFGCTRL_X0Y1 [get_cells clkgen/mig_sys_clk_200_bufg]
set_property LOC BUFGCTRL_X0Y4 [get_cells clkgen/clkfb_bufg]
set_property LOC BUFGCTRL_X0Y16 [get_cells clk100mhz_IBUF_BUFG_inst]

# Location of BUFH Primitives 
set_property LOC BUFHCE_X1Y12 [get_cells u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/u_bufh_pll_clk3]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports clk100mhz]

# Clock net "u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/CLK" driven by instance "u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/u_bufg_clkdiv0" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/CLK}
add_cells_to_pblock [get_pblocks  {CLKAG_u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/CLK}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/gen_ui_extra_clocks.mmcm_i} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/CLK"}]]]
resize_pblock [get_pblocks {CLKAG_u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/CLK}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "demo_clk_ctrl/soc_clk" driven by instance "demo_clk_ctrl/soc_clk_bufg" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_demo_clk_ctrl/soc_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_demo_clk_ctrl/soc_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="demo_clk_ctrl/soc_clk"}]]]
resize_pblock [get_pblocks {CLKAG_demo_clk_ctrl/soc_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X0Y3:CLOCKREGION_X0Y3 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2 CLOCKREGION_X1Y3:CLOCKREGION_X1Y3}
#endgroup

# Clock net "clkgen/soc_clk_100mhz" driven by instance "clkgen/soc_clk_100_bufg" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_clkgen/soc_clk_100mhz}
add_cells_to_pblock [get_pblocks  {CLKAG_clkgen/soc_clk_100mhz}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=demo_clk_ctrl/soc_clk_bufg} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clkgen/soc_clk_100mhz"}]]]
resize_pblock [get_pblocks {CLKAG_clkgen/soc_clk_100mhz}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "clkgen/mig_sys_clk_200mhz" driven by instance "clkgen/mig_sys_clk_200_bufg" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_clkgen/mig_sys_clk_200mhz}
add_cells_to_pblock [get_pblocks  {CLKAG_clkgen/mig_sys_clk_200mhz}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_bupt_riscv_mig/u_bupt_riscv_mig_mig/u_ddr2_infrastructure/plle2_i} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clkgen/mig_sys_clk_200mhz"}]]]
resize_pblock [get_pblocks {CLKAG_clkgen/mig_sys_clk_200mhz}] -add {CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "clk100mhz_IBUF_BUFG" driven by instance "clk100mhz_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y16"
